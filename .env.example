# Local defaults are automatic. Never commit real passwords or JWT signing keys.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=vapor_username
DATABASE_PASSWORD=vapor_password
DATABASE_NAME=vapor_database
PORT=8080
# Railway: reference your Postgres service's DATABASE_URL instead of the fields above.
# DATABASE_URL=postgresql://user:password@host:5432/database
# Railway's stock Postgres certificate is private/self-signed; use only with Railway's private DATABASE_URL.
# DATABASE_TLS_MODE=require-unverified
# JWT_SECRET=generate-at-least-32-random-bytes
# Comma-separated Apple audiences accepted by the API. Keep the iOS bundle ID
# and add the web Services ID after configuring Sign in with Apple for the web.
# APPLE_CLIENT_IDS=com.bausch.Nestic-iOS,com.example.nestic.web
# APPLE_CLIENT_ID remains supported for an iOS-only deployment.
# Resend email delivery. Verify nestic-app.com in Resend, then use a restricted
# sending API key stored only in Railway. The default sender is below.
# RESEND_API_KEY=re_...
# RESEND_FROM=Nestic <noreply@nestic-app.com>
# API_PUBLIC_URL=https://api.nestic-app.com
# WEB_APP_URL=https://www.nestic-app.com
# AUTH_RECOVERY_LIMIT=5
# AUTH_RECOVERY_WINDOW_SECONDS=3600
# AUTO_MIGRATE=true
# Optional manual Pro access for testing/support. Use a comma-separated list
# of normalized account emails; do not expose this variable to the web client.
# NESTIC_MANUAL_PRO_EMAILS=you@example.com,tester@example.com
# Optional additional platform administrators. baus8650@gmail.com is always
# included as the primary administrator. Admins can use the private dashboard
# and respond to user feedback conversations.
# NESTIC_ADMIN_EMAILS=another-admin@example.com
# Optional local-only sample account/data (otherwise create your own account in iOS):
# SEED_DEMO_DATA=true
# One-shot App Review fixture. Set these only for the deploy that should create
# the account, then remove SEED_APP_REVIEW_DATA and APP_REVIEW_SEED_PASSWORD.
# SEED_APP_REVIEW_DATA=true
# APP_REVIEW_SEED_PASSWORD=choose-a-secret-outside-source-control
# Cloudflare R2 private subject photo storage.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=nestic-photos
# R2_ACCESS_KEY_ID=<Cloudflare S3 Access Key ID>
# R2_SECRET_ACCESS_KEY=<Cloudflare S3 Secret Access Key>
# R2 safety limits. These protect the bucket if a tester uploads or refreshes aggressively.
# R2_MAX_UPLOAD_BYTES=524288
# R2_DAILY_UPLOAD_BYTES_PER_USER=5242880
# R2_DAILY_UPLOADS_PER_USER=20
# R2_UPLOADS_PER_MINUTE_PER_USER=6
# R2_DAILY_READS_PER_USER=1000
# R2_READS_PER_MINUTE_PER_USER=60
# R2_DAILY_UPLOAD_BYTES_TOTAL=104857600
# R2_DAILY_UPLOADS_TOTAL=500
# R2_DAILY_READS_TOTAL=10000
